<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Main%20Menu%20UI.uss?fileID=7433441132597879392&amp;guid=cb2c2d4af6531fa4492407b7f42d39ef&amp;type=3#Main Menu UI" />
    <engine:VisualElement style="flex-grow: 0; width: 100%; height: 100%; flex-direction: row-reverse; -unity-background-image-tint-color: rgb(255, 255, 255); background-image: none; background-color: rgba(0, 0, 0, 0);">
        <engine:VisualElement style="flex-grow: 0; background-color: rgba(0, 0, 0, 0.43); justify-content: flex-start; height: 100%; width: 100%;">
            <engine:VisualElement style="flex-grow: 0; width: 100%; height: auto; align-self: auto; align-items: flex-end; align-content: stretch; flex-direction: row-reverse; justify-content: space-between;">
                <engine:Button text="Button" name="Quit" style="width: 50px; height: 50px; color: rgba(27, 27, 27, 0); background-image: url(&quot;project://database/Assets/Art/UI/give_up_button.png?fileID=2800000&amp;guid=78dd96e2af1e15d41b82194e18f4e460&amp;type=3#give_up_button&quot;); background-color: rgba(188, 188, 188, 0); margin-top: 30px; margin-right: 30px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <engine:VisualElement style="flex-grow: 1; flex-direction: row; align-self: flex-start;">
                    <engine:Button text="Button" name="HelpButton" style="background-image: url(&quot;project://database/Assets/Art/UI/help_button.png?fileID=2800000&amp;guid=e8b0433c67af47f4d8ae28586ed9b9e9&amp;type=3#help_button&quot;); color: rgba(27, 27, 27, 0); width: 50px; height: 50px; align-items: auto; background-color: rgba(188, 188, 188, 0); margin-top: 30px; margin-left: 30px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement style="flex-grow: 0; width: 100%; height: 100%; flex-direction: row;">
                <engine:VisualElement style="flex-grow: 0; width: 100%; height: 100%; margin-top: 20px; margin-bottom: 20px; align-items: center; justify-content: center;" />
                <engine:VisualElement style="flex-grow: 0; height: 100%; width: 30%; margin-right: 200px; align-self: auto; align-items: flex-start; justify-content: space-around;">
                    <engine:Button name="Play" style="width: 300px; height: 100px; background-image: url(&quot;project://database/Assets/Art/UI/Placeholder_start.png?fileID=2800000&amp;guid=1f639528c80cd5c41af11a29c2fc737a&amp;type=3#Placeholder_start&quot;); -unity-text-outline-color: rgba(0, 0, 0, 0); background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
                    <engine:VisualElement style="flex-grow: 0;" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="ConfirmationScreen" style="flex-grow: 0; width: 30%; height: 40%; flex-shrink: 0; display: none; align-items: center; align-self: center; position: absolute; top: auto; left: 30%; right: 30%; bottom: auto; background-image: url(&quot;project://database/Assets/Art/UI/background_settings.png?fileID=2800000&amp;guid=0847f77f8b92c774f80d0bdd8b8bb475&amp;type=3#background_settings&quot;);">
            <engine:VisualElement style="flex-grow: 0; flex-shrink: 0; width: 100%; height: 100%; justify-content: center;">
                <engine:Label style="align-self: center; justify-content: flex-start; align-items: auto; font-size: 37px; color: rgb(255, 0, 0); text-shadow: 5px 5px 0 rgb(0, 0, 0); background-image: url(&quot;project://database/Assets/Art/UI/are_u_sure.png?fileID=2800000&amp;guid=4ed8a6816a80ed047b42f41cb00e5e35&amp;type=3#are_u_sure&quot;); height: 147px; width: 186px;" />
                <engine:Button name="ActualQuitButton" style="width: 30%; height: 15%; align-self: center; background-image: url(&quot;project://database/Assets/Art/UI/are_u_sure_yes.png?fileID=2800000&amp;guid=febb6b1a47143224da43a620fbc81e2b&amp;type=3#are_u_sure_yes&quot;);" />
                <engine:Button name="Cancel" style="width: 30%; height: 15%; align-self: center; background-image: url(&quot;project://database/Assets/Art/UI/are_u_sure_no.png?fileID=2800000&amp;guid=0244810f12c47424ea2ec92c95446529&amp;type=3#are_u_sure_no&quot;);" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:VisualElement name="HelpScreen" style="flex-grow: 0; flex-shrink: 0; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Art/UI/background_place_holder_.png?fileID=2800000&amp;guid=e2c9f08d3d48c6a459505f2270ac2d14&amp;type=3#background_place_holder_&quot;); display: none;">
        <engine:Button text="Button" name="CloseHelpButton" style="background-image: url(&quot;project://database/Assets/Art/UI/help_button.png?fileID=2800000&amp;guid=e8b0433c67af47f4d8ae28586ed9b9e9&amp;type=3#help_button&quot;); color: rgba(27, 27, 27, 0); width: 50px; height: 50px; align-items: auto; background-color: rgba(188, 188, 188, 0); margin-top: 30px; margin-left: 30px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
        <engine:VisualElement name="HelpText" style="flex-grow: 0; width: 100%; height: 100%;">
            <engine:TextField placeholder-text="Here you can place your ships on any tiles of your choice by clicking and dragging. You can also turn the ships to your liking. Once you are done placing your ships, you can press the continue button to start playing against your opponent." multiline="true" style="height: 209px;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
