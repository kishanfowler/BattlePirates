    <ui:VisualElement style="flex-grow: 0; width: 100%; height: 100%; align-content: auto; align-items: flex-start; align-self: auto; background-color: rgba(255, 11, 11, 0); flex-direction: column; justify-content: center; flex-wrap: nowrap; background-image: url(&quot;project://database/Assets/Art/background_placeholder.png?fileID=2800000&amp;guid=16a68e5ec36f24e4c89569b97e1f086e&amp;type=3#background_placeholder&quot;);">
